{
  "name": "pitwall-weather",
  "version": "1.0.0",
  "private": true,
  "description": "Local racetrack weather comparison and session planning application",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.ts --host 127.0.0.1 --port 5173",
    "build": "vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-transform-types --test tests/*.test.*",
    "prestart": "npm run build",
    "start": "node scripts/start.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "3.8.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
